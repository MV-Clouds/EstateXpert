<messaging:emailTemplate subject="New Lead Assigned – Action Required"
                         recipientType="User"
                         relatedToType="Contact">

    <messaging:htmlEmailBody >
        <html>
            <body style="margin:0; padding:0; background-color:#f5f7fa; font-family: Arial, sans-serif; color:#333;">
                
                <table width="100%" cellpadding="0" cellspacing="0" style="padding:20px;">
                    <tr>
                        <td align="center">

                            <!-- Main Card -->
                            <table width="100%" cellpadding="0" cellspacing="0"
                                   style="max-width:620px; background:#ffffff; border-radius:8px; box-shadow:0 4px 10px rgba(0,0,0,0.08); overflow:hidden;">

                                <!-- Header -->
                                <tr>
                                    <td style="background:#2b6cb0; padding:20px;">
                                        <h2 style="margin:0; color:#ffffff; font-weight:normal;">
                                            New Lead Assigned
                                        </h2>
                                        <p style="margin:5px 0 0; color:#e2e8f0; font-size:14px;">
                                            A new opportunity is waiting for your follow-up
                                        </p>
                                    </td>
                                </tr>

                                <!-- Content -->
                                <tr>
                                    <td style="padding:25px;">
                                        <p style="margin-top:0;">
                                            Hi <strong>{!recipient.FirstName}</strong>,
                                        </p>

                                        <p>
                                            You’ve been assigned a new lead in Salesforce. Here are the key details to help you get started:
                                        </p>

                                        <!-- Details Table -->
                                        <table width="100%" cellpadding="0" cellspacing="0"
                                               style="border-collapse:collapse; margin-top:15px;">

                                            <apex:outputPanel rendered="{!OR(NOT(ISBLANK(relatedTo.FirstName)), NOT(ISBLANK(relatedTo.LastName)))}">
                                                <tr>
                                                    <td style="padding:10px; background:#f7fafc; border:1px solid #e2e8f0;">
                                                        <strong>Lead Name</strong>
                                                    </td>
                                                    <td style="padding:10px; border:1px solid #e2e8f0;">
                                                        {!relatedTo.FirstName} {!relatedTo.LastName}
                                                    </td>
                                                </tr>
                                            </apex:outputPanel>

                                            <apex:outputPanel rendered="{!NOT(ISBLANK(relatedTo.Email))}">
                                                <tr>
                                                    <td style="padding:10px; background:#f7fafc; border:1px solid #e2e8f0;"><strong>Email</strong></td>
                                                    <td style="padding:10px; border:1px solid #e2e8f0;">{!relatedTo.Email}</td>
                                                </tr>
                                            </apex:outputPanel>

                                            <apex:outputPanel rendered="{!NOT(ISBLANK(relatedTo.Phone))}">
                                                <tr>
                                                    <td style="padding:10px; background:#f7fafc; border:1px solid #e2e8f0;"><strong>Phone</strong></td>
                                                    <td style="padding:10px; border:1px solid #e2e8f0;">{!relatedTo.Phone}</td>
                                                </tr>
                                            </apex:outputPanel>

                                            <apex:outputPanel rendered="{!NOT(ISBLANK(relatedTo.Contact_Type__c))}">
                                                <tr>
                                                    <td style="padding:10px; background:#f7fafc; border:1px solid #e2e8f0;"><strong>Contact Type</strong></td>
                                                    <td style="padding:10px; border:1px solid #e2e8f0;">{!relatedTo.Contact_Type__c}</td>
                                                </tr>
                                            </apex:outputPanel>

                                        </table>

                                        <!-- CTA Button -->
                                        <div style="text-align:center; margin:30px 0;">
                                            <a href="{!LEFT($Api.Enterprise_Server_URL_600, FIND('/services', $Api.Enterprise_Server_URL_600)-1)}/{!relatedTo.Id}"
                                               style="background:#2b6cb0; color:#ffffff; text-decoration:none; padding:12px 24px; border-radius:6px; font-size:14px; display:inline-block;">
                                                View Lead in Salesforce
                                            </a>
                                        </div>

                                        <p style="margin-bottom:0;">
                                            Please review the lead and take the next steps at your earliest convenience.
                                        </p>

                                        <p style="margin-top:20px;">
                                            Best regards,<br/>
                                            <strong>EstateXpert Team</strong>
                                        </p>
                                    </td>
                                </tr>

                                <!-- Footer -->
                                <tr>
                                    <td style="background:#f7fafc; padding:15px; text-align:center; font-size:12px; color:#718096;">
                                        This is an automated notification. Please do not reply to this email.
                                    </td>
                                </tr>

                            </table>
                        </td>
                    </tr>
                </table>
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>