<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Offer_Amount_Rule</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Listing_Price__c)),
    Offer_Amount__c &gt; Listing_Price__c
)</errorConditionFormula>
    <errorDisplayField>Offer_Amount__c</errorDisplayField>
    <errorMessage>The Offer Amount cannot exceed the Listing Price.</errorMessage>
</ValidationRule>
