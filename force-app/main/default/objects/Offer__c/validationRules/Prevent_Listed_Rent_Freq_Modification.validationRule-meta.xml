<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Listed_Rent_Freq_Modification</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    TEXT(Listing_Type__c) = &apos;Rent&apos;,
    ISCHANGED(Listed_Rent_Frequency__c),
    NOT(ISBLANK(PRIORVALUE(Listed_Rent_Frequency__c)))
)</errorConditionFormula>
    <errorDisplayField>Listed_Rent_Frequency__c</errorDisplayField>
    <errorMessage>The Listing Price cannot be changed once it has been set.</errorMessage>
</ValidationRule>
