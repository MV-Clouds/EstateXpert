<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Listing_Price_Modification</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    TEXT(Listing_Type__c) = &apos;Sale&apos;,
    ISCHANGED(Listing_Price__c),
    NOT(ISBLANK(PRIORVALUE(Listing_Price__c)))
)</errorConditionFormula>
    <errorDisplayField>Listing_Price__c</errorDisplayField>
    <errorMessage>The Listing Price cannot be changed once it has been set.</errorMessage>
</ValidationRule>
