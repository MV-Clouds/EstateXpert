            .manual-modal-footer {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 16px 24px;
                width: 100%;
                background: #FFFFFF;
                border-top: 1px solid #E5E7EB;
                flex-shrink: 0;
                box-sizing: border-box;
                border-bottom-left-radius: 12px;
                border-bottom-right-radius: 12px;
