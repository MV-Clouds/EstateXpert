                        <span id="manual-error-text">Please fill in all required fields.</span>
                    </div>

                    <div class="manual-field-group">
                        <label class="manual-field-label" for="manual-app-id">
                            Meta Application ID <span class="required-star">*</span>
                        </label>
                        <input type="text" id="manual-app-id" class="manual-field-input"
                            placeholder="e.g., 514916280628381" value="{!appId}" />
                    </div>

                    <div class="manual-field-group">
                        <label class="manual-field-label" for="manual-waba-id">
                            WhatsApp Business Account ID (WABA ID) <span class="required-star">*</span>
                        </label>
                        <input type="text" id="manual-waba-id" class="manual-field-input"
                            placeholder="e.g., 8971126402921271" value="{!businessAccountId}" />
                    </div>

                    <div class="manual-field-group">
                        <label class="manual-field-label" for="manual-phone-id">
                            Phone Number ID <span class="required-star">*</span>
                        </label>
                        <input type="text" id="manual-phone-id" class="manual-field-input"
                            placeholder="e.g., 765432109876543" value="{!phoneNumberId}" />
                    </div>

                    <div class="manual-field-group">
                        <label class="manual-field-label" for="manual-access-token">
                            Permanent Access Token <span class="required-star">*</span>
                        </label>
                        <textarea id="manual-access-token" class="manual-field-input manual-field-textarea"
                            placeholder="Enter System User / Permanent Access Token">{!accessToken}</textarea>
                    </div>
                </div>
                <div class="manual-modal-footer">
                    <button type="button" class="exp-white-btn-css" onclick="closeManualConfigModal()">
                        <svg width="12" height="12" viewBox="0 0 20 20" fill="none">
                            <path
                                d="M2.53317 19.3333L0.666504 17.4667L8.13317 9.99999L0.666504 2.53332L2.53317 0.666656L9.99984 8.13332L17.4665 0.666656L19.3332 2.53332L11.8665 9.99999L19.3332 17.4667L17.4665 19.3333L9.99984 11.8667L2.53317 19.3333Z"
                                fill="currentColor" />
                        </svg>
                        Cancel
                    </button>
                    <button type="button" class="exp-blue-btn-css" id="manual-save-btn"
                        onclick="saveManualConfiguration()">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" fill="currentColor" />
                        </svg>
                        Save Configuration
                    </button>
                </div>
            </div>
        </div>

        <!-- Loading Spinner Full Page -->
        <div id="loading-spinner" class="spinner-overlay">
            <div class="spinner-container">
                <div class="spinner-big"></div>
                <div class="spinner-text">Loading...</div>
            </div>
        </div>

        <script>
            let phoneNumberId = '';
            let wabaId = '{!JSENCODE(businessAccountId)}';
            let storedAppId = '{!JSENCODE(appId)}';
            let storedAccessToken = '{!JSENCODE(accessToken)}';
            let storedPhoneNumberId = '{!JSENCODE(phoneNumberId)}';
            let storedLastModifiedDate = '{!JSENCODE(lastModifiedDate)}';

            let appId = '';
            let accessToken = '';
            let apiVersion = '{!JSENCODE(apiVersion)}';
            let apiEndpoint = '{!JSENCODE(apiEndpoint)}';

            var errorDismissTimer = null;

            function showError(msg, isInputError) {
                if (!msg) {
                    hideError();
                    return;
                }

                // Update text in inline error message element
                var errorEl = document.getElementById("error-message");
                if (errorEl) {
                    errorEl.textContent = msg;
                }

                // Highlight input field if it is an input validation error
                if (isInputError) {
                    var inputEl = document.getElementById("app-id-input");
                    if (inputEl) {
                        inputEl.classList.add("input-error");
                    }
                }

                // Show inline banner below form
                var banner = document.getElementById("error-message-container");
                if (banner) {
                    banner.classList.remove("fade-out");
                    banner.style.display = "flex";
                }

                // Reset button loading state
                resetButton();

                // Auto hide after at least 5 seconds
                if (errorDismissTimer) {
                    clearTimeout(errorDismissTimer);
                }
                errorDismissTimer = setTimeout(function () {
                    hideError();
                }, 5000);
            }

            function hideError() {
                if (errorDismissTimer) {
                    clearTimeout(errorDismissTimer);
                    errorDismissTimer = null;
                }

                var banner = document.getElementById("error-message-container");
                if (banner && banner.style.display !== "none") {
                    banner.classList.add("fade-out");
                    setTimeout(function () {
                        banner.style.display = "none";
                        banner.classList.remove("fade-out");
                    }, 250);
                }

                var inputEl = document.getElementById("app-id-input");
                if (inputEl) {
                    inputEl.classList.remove("input-error");
                }
            }

            function setLoading(loading, msg) {
                var btn = document.getElementById('connect-btn');
                var btnText = document.getElementById('btn-text');
                var spinner = document.getElementById('btn-spinner');
                var overlay = document.getElementById('loading-spinner');

                if (loading) {
                    if (msg) {
                        overlay.classList.add('show');
                        var txtEl = overlay.querySelector('.spinner-text');
                        if (txtEl) txtEl.textContent = msg;
                    } else {
                        if (btn) btn.disabled = true;
                        if (btnText) btnText.textContent = 'Connecting...';
                        if (spinner) spinner.style.display = 'block';
                    }
                } else {
                    overlay.classList.remove('show');
                    if (btn) btn.disabled = false;
                    if (btnText) btnText.textContent = 'Connect with WhatsApp';
                    if (spinner) spinner.style.display = 'none';
                }
            }

            function resetButton() {
                setLoading(false);
            }

            function showSpinner(message) {
                setLoading(true, message || 'Loading...');
            }

            function hideSpinner() {
                setLoading(false);
            }

            function showConfirmationModal() {
                const modal = document.getElementById('confirmation-modal');
                if (modal) modal.classList.add('show');
            }

            function closeConfirmationModal() {
                const modal = document.getElementById('confirmation-modal');
                if (modal) modal.classList.remove('show');
            }

            function openManualConfigModal() {
                const modal = document.getElementById('manual-config-modal');
                const manualAppIdInput = document.getElementById('manual-app-id');
                const existingAppId = document.getElementById('app-id-input') ? document.getElementById('app-id-input').value.trim() : '';
                if (existingAppId && manualAppIdInput && !manualAppIdInput.value) {
                    manualAppIdInput.value = existingAppId;
                }
                const errorAlert = document.getElementById('manual-error-alert');
                if (errorAlert) errorAlert.classList.remove('show');
                if (modal) modal.classList.add('show');
            }

            function closeManualConfigModal() {
                const modal = document.getElementById('manual-config-modal');
                if (modal) modal.classList.remove('show');
            }

            function saveManualConfiguration() {
                const appIdVal = document.getElementById('manual-app-id').value.trim();
                const wabaIdVal = document.getElementById('manual-waba-id').value.trim();
                const phoneIdVal = document.getElementById('manual-phone-id').value.trim();
                const tokenVal = document.getElementById('manual-access-token').value.trim();
                const errorAlert = document.getElementById('manual-error-alert');
                const errorText = document.getElementById('manual-error-text');

                if (!appIdVal || !wabaIdVal || !phoneIdVal || !tokenVal) {
                    if (errorText) errorText.textContent = 'Please fill in all 4 fields (Meta App ID, WABA ID, Phone Number ID, and Access Token).';
                    if (errorAlert) errorAlert.classList.add('show');
                    return;
                }

                if (errorAlert) errorAlert.classList.remove('show');
                closeManualConfigModal();
                showSpinner('Saving WhatsApp credentials...');

                Visualforce.remoting.Manager.invokeAction(
                    '{!$RemoteAction.WhatsappConnectController.saveManualDetails}',
                    tokenVal, phoneIdVal, wabaIdVal, appIdVal,
                    function (result, event) {
                        if (event.status && result) {
                            const spinner = document.getElementById('loading-spinner');
                            const spinnerText = spinner ? spinner.querySelector('.spinner-text') : null;
                            const spinnerIcon = spinner ? (spinner.querySelector('.spinner-big') || spinner.querySelector('.spinner')) : null;

                            if (spinnerIcon) spinnerIcon.style.borderTopColor = '#16a34a';
                            if (spinnerText) spinnerText.textContent = 'WhatsApp credentials saved successfully! Refreshing...';

                            setTimeout(() => {
                                window.location.reload();
                            }, 2500);
                        } else {
                            hideSpinner();
                            showError("Error saving WhatsApp credentials. Please try again.");
                        }
                    },
                    {
                        escape: true
                    }
                );
            }

            window.addEventListener('click', function (e) {
                const manualModal = document.getElementById('manual-config-modal');
                if (e.target === manualModal) {
                    closeManualConfigModal();
                }
                const confirmModal = document.getElementById('confirmation-modal');
                if (e.target === confirmModal) {
                    closeConfirmationModal();
                }
            });

            window.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeManualConfigModal();
                    closeConfirmationModal();
                }
            });

            function copyToClipboard(elementId) {
                var targetId = elementId || 'waba-id-display';
                var el = document.getElementById(targetId);
                var text = el ? el.textContent.trim() : '';
                if (!text) return;
                navigator.clipboard.writeText(text).then(function () {
                    var btn = event ? (event.currentTarget || event.target.closest('.copy-btn')) : null;
                    if (btn) {
                        var originalHtml = btn.innerHTML;
                        btn.innerHTML = '<svg viewBox="0 0 20 20" fill="#10B981" style="width:18px;height:18px;"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>';
                        setTimeout(function () {
                            btn.innerHTML = originalHtml;
                        }, 2000);
                    }
                });
            }

            function backToControlCenter() {
                window.top.location.href = '/lightning/n/Control_Center_Dev';
            }

            // --- Contact Object Configuration Logic ---
            var contactConfigData = {
                phoneFields: [],
                requiredFields: [],
                savedChatPhone: '',
                savedWebhookPhone: '',
                savedFieldValues: {},
                isDirty: false
            };

            function escapeHtml(str) {
                if (!str) return '';
                var div = document.createElement('div');
                div.textContent = str;
                return div.innerHTML;
            }

            function toggleAccordion(itemId) {
                var el = document.getElementById(itemId);
                if (el) {
                    el.classList.toggle('open');
                }
            }

            function markObjConfigDirty() {
                contactConfigData.isDirty = true;
                var saveBtn = document.getElementById('save-obj-config-btn');
                if (saveBtn) {
                    saveBtn.disabled = false;
                }
            }

            function enableObjConfigEdit() {
                var viewActions = document.getElementById('obj-view-actions');
                var editActions = document.getElementById('obj-edit-actions');
                var chatView = document.getElementById('chat-view-panel');
                var chatEdit = document.getElementById('chat-edit-panel');
                var webhookView = document.getElementById('webhook-view-panel');
                var webhookEdit = document.getElementById('webhook-edit-panel');

                if (viewActions) viewActions.style.display = 'none';
                if (editActions) editActions.style.display = 'flex';
                if (chatView) chatView.style.display = 'none';
                if (chatEdit) chatEdit.style.display = 'block';
                if (webhookView) webhookView.style.display = 'none';
                if (webhookEdit) webhookEdit.style.display = 'block';

                var chatAccordion = document.getElementById('chat-accordion-item');
                var webhookAccordion = document.getElementById('webhook-accordion-item');
                if (chatAccordion) chatAccordion.classList.add('open');
                if (webhookAccordion) webhookAccordion.classList.add('open');

                contactConfigData.isDirty = false;
                var saveBtn = document.getElementById('save-obj-config-btn');
                if (saveBtn) saveBtn.disabled = true;
            }

            function cancelObjConfigEdit() {
                var viewActions = document.getElementById('obj-view-actions');
                var editActions = document.getElementById('obj-edit-actions');
                var chatView = document.getElementById('chat-view-panel');
                var chatEdit = document.getElementById('chat-edit-panel');
                var webhookView = document.getElementById('webhook-view-panel');
                var webhookEdit = document.getElementById('webhook-edit-panel');

                if (viewActions) viewActions.style.display = 'block';
                if (editActions) editActions.style.display = 'none';
                if (chatView) chatView.style.display = 'block';
                if (chatEdit) chatEdit.style.display = 'none';
                if (webhookView) webhookView.style.display = 'block';
                if (webhookEdit) webhookEdit.style.display = 'none';

                var chatAccordion = document.getElementById('chat-accordion-item');
                var webhookAccordion = document.getElementById('webhook-accordion-item');
                if (chatAccordion) chatAccordion.classList.remove('open');
                if (webhookAccordion) webhookAccordion.classList.remove('open');

                contactConfigData.isDirty = false;
                renderContactConfig();
            }

            function loadContactConfig() {
                Visualforce.remoting.Manager.invokeAction(
                    '{!$RemoteAction.WhatsappConnectController.getContactObjectConfig}',
                    function (result, event) {
                        if (event.status && result && result.success) {
                            var phoneFieldList = [];
                            if (result.phoneFields && Array.isArray(result.phoneFields)) {
                                phoneFieldList = result.phoneFields;
                            } else if (result.phoneAndTextFields && result.phoneAndTextFields.length > 0 && result.phoneAndTextFields[0].phoneFields) {
                                phoneFieldList = result.phoneAndTextFields[0].phoneFields;
                            } else if (result.requiredFields && result.requiredFields.length > 0 && result.requiredFields[0].phoneFields) {
                                phoneFieldList = result.requiredFields[0].phoneFields;
                            }
                            contactConfigData.phoneFields = phoneFieldList;

                            var reqList = [];
                            if (result.requiredFields && Array.isArray(result.requiredFields)) {
                                if (result.requiredFields.length > 0 && result.requiredFields[0].requiredFields) {
                                    reqList = result.requiredFields[0].requiredFields;
                                } else {
                                    reqList = result.requiredFields;
                                }
                            }
                            contactConfigData.requiredFields = reqList;

                            var savedWebhookPhone = '';
                            var savedValues = {};
                            if (result.savedConfig && result.savedConfig.ObjectConfigInfo) {
                                try {
                                    var objInfo = JSON.parse(result.savedConfig.ObjectConfigInfo);
                                    if (objInfo && typeof objInfo === 'object') {
                                        savedWebhookPhone = objInfo.phoneField || '';
                                        if (objInfo.requiredFields && Array.isArray(objInfo.requiredFields)) {
                                            objInfo.requiredFields.forEach(function (rf) {
                                                if (rf && rf.name) {
                                                    savedValues[rf.name] = rf.value;
                                                }
                                            });
                                        }
                                    }
                                } catch (e) {
                                    console.error('Error parsing ObjectConfigInfo:', e);
                                }
                            }
                            contactConfigData.savedFieldValues = savedValues;

                            var savedChatPhone = '';
                            if (result.savedConfig && result.savedConfig.ChatWindowConfigInfo) {
                                try {
                                    var chatInfo = JSON.parse(result.savedConfig.ChatWindowConfigInfo);
                                    if (chatInfo && chatInfo.Contact) {
                                        savedChatPhone = chatInfo.Contact.phoneField || '';
                                    }
                                } catch (e) {
                                    console.error('Error parsing ChatWindowConfigInfo:', e);
                                }
                            }

                            // Fallback logic for phone field: saved -> 'Phone' -> first available
                            var defaultPhone = '';
                            if (savedWebhookPhone) {
                                defaultPhone = savedWebhookPhone;
                            } else if (savedChatPhone) {
                                defaultPhone = savedChatPhone;
                            } else {
                                var hasPhone = phoneFieldList.some(function (f) { return f.value === 'Phone'; });
                                if (hasPhone) {
                                    defaultPhone = 'Phone';
                                } else if (phoneFieldList.length > 0) {
                                    defaultPhone = phoneFieldList[0].value;
                                }
                            }

                            contactConfigData.savedWebhookPhone = savedWebhookPhone || defaultPhone;
                            contactConfigData.savedChatPhone = savedChatPhone || defaultPhone;

                            renderContactConfig();
                        } else {
                            console.error('Failed to load contact config:', event);
                        }
                    },
                    { escape: true }
                );
            }

            function renderContactConfig() {
                var phoneList = contactConfigData.phoneFields;
                var reqList = contactConfigData.requiredFields;
                var chatPhone = contactConfigData.savedChatPhone;
                var webhookPhone = contactConfigData.savedWebhookPhone;
                var savedVals = contactConfigData.savedFieldValues;

                // Find labels
                var chatPhoneLabel = chatPhone;
                var webhookPhoneLabel = webhookPhone;
                phoneList.forEach(function (p) {
                    if (p.value === chatPhone) {
                        chatPhoneLabel = p.label + ' (' + p.value + ')';
                    }
                    if (p.value === webhookPhone) {
                        webhookPhoneLabel = p.label + ' (' + p.value + ')';
                    }
                });

                // Top bar tag
                var tagEl = document.getElementById('active-phone-tag');
                var tagTextEl = document.getElementById('active-phone-tag-text');
                if (tagEl && tagTextEl) {
                    if (webhookPhoneLabel) {
                        tagTextEl.textContent = webhookPhoneLabel;
                        tagEl.style.display = 'inline-flex';
                    } else {
                        tagEl.style.display = 'none';
                    }
                }

                // View Mode - Chat Window
                var chatViewEl = document.getElementById('chat-phone-view-val');
                if (chatViewEl) {
                    chatViewEl.textContent = chatPhoneLabel || '-';
                }

                // View Mode - Webhook Phone
                var webhookViewEl = document.getElementById('webhook-phone-view-val');
                if (webhookViewEl) {
                    webhookViewEl.textContent = webhookPhoneLabel || '-';
                }

                // View Mode - Webhook Required Fields
                var reqViewBody = document.getElementById('webhook-req-fields-view-body');
                if (reqViewBody) {
                    reqViewBody.innerHTML = '';
                    if (!reqList || reqList.length === 0) {
                        reqViewBody.innerHTML = '<tr><td colspan="3" style="text-align:center; color:#94a3b8;">No required fields for Contact</td></tr>';
                    } else {
                        reqList.forEach(function (rf) {
                            var currentVal = savedVals[rf.name] !== undefined ? savedVals[rf.name] : (rf.value || '');
                            var tr = document.createElement('tr');
                            tr.innerHTML = '<td><strong>' + escapeHtml(rf.name) + '</strong></td>' +
                                           '<td>' + escapeHtml(rf.type || 'String') + '</td>' +
                                           '<td>' + (currentVal ? escapeHtml(currentVal) : '<em style="color:#94a3b8;">Not specified</em>') + '</td>';
                            reqViewBody.appendChild(tr);
                        });
                    }
                }

                // Edit Mode - Chat Window dropdown
                var chatSelect = document.getElementById('chat-phone-select');
                if (chatSelect) {
                    chatSelect.innerHTML = '';
                    phoneList.forEach(function (p) {
                        var opt = document.createElement('option');
                        opt.value = p.value;
                        opt.textContent = p.label + ' (' + p.value + ')';
                        if (p.value === chatPhone) {
                            opt.selected = true;
                        }
                        chatSelect.appendChild(opt);
                    });
                }

                // Edit Mode - Webhook Phone dropdown
                var webhookSelect = document.getElementById('webhook-phone-select');
                if (webhookSelect) {
                    webhookSelect.innerHTML = '';
                    phoneList.forEach(function (p) {
                        var wopt = document.createElement('option');
                        wopt.value = p.value;
                        wopt.textContent = p.label + ' (' + p.value + ')';
                        if (p.value === webhookPhone) {
                            wopt.selected = true;
                        }
                        webhookSelect.appendChild(wopt);
                    });
                }

                // Edit Mode - Webhook Required Fields inputs
                var reqEditBody = document.getElementById('webhook-req-fields-edit-body');
                if (reqEditBody) {
                    reqEditBody.innerHTML = '';
                    if (!reqList || reqList.length === 0) {
                        reqEditBody.innerHTML = '<tr><td colspan="3" style="text-align:center; color:#94a3b8;">No required fields for Contact</td></tr>';
                    } else {
                        reqList.forEach(function (erf) {
                            var evalVal = savedVals[erf.name] !== undefined ? savedVals[erf.name] : (erf.value || '');
                            var etr = document.createElement('tr');
                            var inputHtml = '';
                            var typeUpper = (erf.type || 'STRING').toUpperCase();

                            if (typeUpper === 'PICKLIST' && erf.picklistValues && erf.picklistValues.length > 0) {
                                inputHtml = '<select class="obj-combobox" data-field="' + escapeHtml(erf.name) + '" data-type="' + escapeHtml(typeUpper) + '" onchange="markObjConfigDirty()">';
                                erf.picklistValues.forEach(function (pv) {
                                    var isSel = (pv.value === evalVal) ? 'selected="selected"' : '';
                                    inputHtml += '<option value="' + escapeHtml(pv.value) + '" ' + isSel + '>' + escapeHtml(pv.label) + '</option>';
                                });
                                inputHtml += '</select>';
                            } else if (typeUpper === 'BOOLEAN') {
                                var isChk = (evalVal === true || evalVal === 'true') ? 'checked="checked"' : '';
                                inputHtml = '<input type="checkbox" class="obj-checkbox-input" data-field="' + escapeHtml(erf.name) + '" data-type="' + escapeHtml(typeUpper) + '" ' + isChk + ' onchange="markObjConfigDirty()"/>';
                            } else if (typeUpper === 'INTEGER' || typeUpper === 'DOUBLE' || typeUpper === 'CURRENCY') {
                                inputHtml = '<input type="number" class="obj-text-input" data-field="' + escapeHtml(erf.name) + '" data-type="' + escapeHtml(typeUpper) + '" value="' + escapeHtml(evalVal) + '" oninput="markObjConfigDirty()"/>';
                            } else if (typeUpper === 'DATE') {
                                inputHtml = '<input type="date" class="obj-text-input" data-field="' + escapeHtml(erf.name) + '" data-type="' + escapeHtml(typeUpper) + '" value="' + escapeHtml(evalVal) + '" onchange="markObjConfigDirty()"/>';
                            } else {
                                inputHtml = '<input type="text" class="obj-text-input" data-field="' + escapeHtml(erf.name) + '" data-type="' + escapeHtml(typeUpper) + '" value="' + escapeHtml(evalVal) + '" oninput="markObjConfigDirty()"/>';
                            }

                            etr.innerHTML = '<td><strong>' + escapeHtml(erf.name) + '</strong></td>' +
                                            '<td>' + escapeHtml(erf.type || 'String') + '</td>' +
                                            '<td>' + inputHtml + '</td>';
                            reqEditBody.appendChild(etr);
                        });
                    }
                }
            }

            function saveObjConfig() {
                var chatSelect = document.getElementById('chat-phone-select');
                var webhookSelect = document.getElementById('webhook-phone-select');
                var selectedChatPhone = chatSelect ? chatSelect.value : '';
                var selectedWebhookPhone = webhookSelect ? webhookSelect.value : '';

                if (!selectedChatPhone) {
                    showError('Please select a Phone Field under Whatsapp Chat Window Configuration.');
                    return;
                }
                if (!selectedWebhookPhone) {
                    showError('Please select a Phone Field under Whatsapp Webhook Configuration.');
                    return;
                }

                // Gather required fields values
                var reqInputs = document.querySelectorAll('#webhook-req-fields-edit-body [data-field]');
                var reqFieldList = [];
                for (var i = 0; i < reqInputs.length; i++) {
                    var input = reqInputs[i];
                    var fieldName = input.getAttribute('data-field');
                    var fieldType = input.getAttribute('data-type') || 'STRING';
                    var val = input.type === 'checkbox' ? input.checked.toString() : input.value.trim();

                    if (fieldType !== 'BOOLEAN' && !val) {
                        showError('Please enter a default value for ' + fieldName + '.');
                        return;
                    }

                    reqFieldList.push({
                        name: fieldName,
                        value: val,
                        type: fieldType
                    });
                }

                var webhookPayload = {
                    objectApiName: 'Contact',
                    phoneField: selectedWebhookPhone,
                    requiredFields: reqFieldList
                };

                var chatPayload = {
                    Contact: {
                        nameField: '',
                        phoneField: selectedChatPhone,
                        emailField: ''
                    }
                };

                var webhookJson = JSON.stringify(webhookPayload);
                var chatJson = JSON.stringify(chatPayload);

                showSpinner('Saving Contact configuration...');

                Visualforce.remoting.Manager.invokeAction(
                    '{!$RemoteAction.WhatsappConnectController.saveContactObjectConfig}',
                    webhookJson, chatJson,
                    function (result, event) {
                        hideSpinner();
                        if (event.status && result === 'Success') {
                            contactConfigData.savedChatPhone = selectedChatPhone;
                            contactConfigData.savedWebhookPhone = selectedWebhookPhone;
                            for (var j = 0; j < reqFieldList.length; j++) {
                                contactConfigData.savedFieldValues[reqFieldList[j].name] = reqFieldList[j].value;
                            }
                            cancelObjConfigEdit();

                            var spinner = document.getElementById('loading-spinner');
                            var spinnerText = spinner ? spinner.querySelector('.spinner-text') : null;
                            var spinnerIcon = spinner ? (spinner.querySelector('.spinner-big') || spinner.querySelector('.spinner')) : null;
                            if (spinnerIcon) spinnerIcon.style.borderTopColor = '#16a34a';
                            if (spinnerText) spinnerText.textContent = 'Contact configuration saved successfully!';
                            if (spinner) spinner.classList.add('show');
                            setTimeout(function () {
                                if (spinner) spinner.classList.remove('show');
                                if (spinnerIcon) spinnerIcon.style.borderTopColor = '#0176D3';
                            }, 2000);
                        } else {
                            showError(result || 'Failed to save Contact configuration. Please try again.');
                        }
                    },
                    { escape: true }
                );
            }

            document.addEventListener("DOMContentLoaded", function () {
                var appInput = document.getElementById("app-id-input");
                if (appInput) {
                    appInput.addEventListener("input", function () {
                        if (this.value && this.value.trim().length > 0) {
                            this.classList.remove("input-error");
                            hideError();
                        }
                    });
                }

                if (wabaId) {
                    var setupDiv = document.getElementById("setup-form-div");
                    if (setupDiv) setupDiv.style.display = "none";

                    var detailsDiv = document.getElementById("config-details-div") || document.getElementById("results-container");
                    if (detailsDiv) detailsDiv.style.display = "block";

                    var wabaEl = document.getElementById('waba-id-display');
                    if (wabaEl) wabaEl.textContent = wabaId;

                    if (storedPhoneNumberId) {
                        var phoneEl = document.getElementById('phone-id-display');
                        if (phoneEl) phoneEl.textContent = storedPhoneNumberId;
                    }

                    if (storedAppId) {
                        var appEl = document.getElementById('app-id-display');
                        if (appEl) appEl.textContent = storedAppId;
                    }

                    if (storedLastModifiedDate) {
                        var lastEditedEl = document.getElementById('last-edited');
                        if (lastEditedEl) lastEditedEl.textContent = storedLastModifiedDate;
                    }

                    loadContactConfig();
                }
            });

            window.addEventListener('message', (event) => {
                if (event.origin !== "https://www.facebook.com" && event.origin !== "https://web.facebook.com") {
                    return;
                }
                try {
                    const data = JSON.parse(event.data);
                    if (data.type === 'WA_EMBEDDED_SIGNUP') {
                        if (data.event === 'FINISH') {
                            const { phone_number_id, waba_id } = data.data;
                            phoneNumberId = phone_number_id;
                            wabaId = waba_id;
                        } else if (data.event === 'CANCEL') {
                            showError("Please complete all the steps.");
                        } else if (data.event === 'ERROR') {
                            console.error('Embedded Signup Error:', data);
                            const { error_message } = data.data;
                            showError(error_message || "There was an error during WhatsApp Embedded Signup.");
                        }
                    }
                } catch (err) {
                    console.error('Error parsing message event:', err, event.data);
                    if (typeof event.data === 'string' && event.data.includes('error=')) {
                        showError("Could not log you in, please try again...");
                    }
                }
            });

            const fbLoginCallback = (response) => {
                if (response.status === 'connected') {
                    FB.getLoginStatus(function (response) {
                        if (response.status === 'connected') {
                            accessToken = response.authResponse.accessToken;
                            validateAndSubmit();
                        }
                    }, true);
                } else {
                    console.error('Facebook Login failed or was cancelled.', response);
                    showError("Could not authorize with Facebook, please try again...");
                }
            };

            function validateAndSubmit() {
                showSpinner('Validating configuration...');
                appId = document.getElementById("app-id-input").value.trim();
                fetch(apiEndpoint + "/" + apiVersion + "/" + appId + "?access_token=" + accessToken)
                    .then(response => response.json())
                    .then(result => {
                        if (result.error) {
                            console.error('Validation API returned an error:', result.error);
                            hideSpinner();
                            showError("The Application ID is incorrect! Please validate it.", true);
                        } else {
                            if (!phoneNumberId.length || !wabaId.length || !appId.length || !accessToken.length) {
                                hideSpinner();
                                showError("Could not complete login, please try again...");
                                return;
                            }

                            Visualforce.remoting.Manager.invokeAction(
                                '{!$RemoteAction.WhatsappConnectController.saveFBLoginDetails}', accessToken, phoneNumberId, wabaId, appId,
                                function (result, event) {
                                    if (event.status && result) {
                                        showSpinner('Saving configuration...');
                                        setTimeout(() => {
                                            window.location.reload();
                                        }, 3000);
                                    } else {
                                        console.error('Remoting Action Failed:', event.message, event);
                                        hideSpinner();
                                        showError("Error saving configuration, please try again...");
                                    }
                                },
                                {
                                    escape: true
                                }
                            );
                        }
                    })
                    .catch(error => {
                        console.error('Network or fetch error during validation:', error);
                        hideSpinner();
                        showError("Could not validate Application ID! Please try again.", true);
                    });
            }

            const launchWhatsAppSignup = () => {
                appId = document.getElementById("app-id-input").value.trim();
                if (!appId) {
                    showError("Please enter Meta Application ID to proceed.", true);
                    return;
                }
                hideError();
                if (!'{!clientId}') {
                    showError("Could not fetch the configuration data.");
                    return;
                }
                if (typeof FB === 'undefined') {
                    showError("Meta SDK is still loading... please wait a few seconds and try again.");
                    return;
                }
                setLoading(true);
                FB.login(fbLoginCallback, {
                    config_id: '{!configurationId}',
                    response_type: 'code',
                    override_default_response_type: true,
                    extras: {
                        setup: {},
                        featureType: '',
                        sessionInfoVersion: '2',
                    }
                });
            };

            function deactivateWhatsApp() {
                showConfirmationModal();
            }

            function confirmDeactivation() {
                closeConfirmationModal();
                showSpinner('Deactivating integration...');

                Visualforce.remoting.Manager.invokeAction(
                    '{!$RemoteAction.WhatsappConnectController.unlinkAccount}',
                    function (result, event) {
                        if (event.status && result) {
                            const spinner = document.getElementById('loading-spinner');
                            const spinnerText = spinner ? spinner.querySelector('.spinner-text') : null;
                            const spinnerIcon = spinner ? (spinner.querySelector('.spinner-big') || spinner.querySelector('.spinner')) : null;

                            if (spinnerIcon) spinnerIcon.style.borderTopColor = '#16a34a';
                            if (spinnerText) spinnerText.textContent = 'WhatsApp integration disconnected successfully! Please wait and refresh the page...';

                            setTimeout(() => {
                                window.location.reload();
                            }, 2500);
                        } else {
                            hideSpinner();
                            showError("Error deactivating WhatsApp integration. Please try again.");
                        }
                    },
                    {
                        escape: true
                    }
                );
            }
        </script>
    </body>

    </html>
</apex:page>