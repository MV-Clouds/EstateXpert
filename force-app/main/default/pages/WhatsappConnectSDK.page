                box-shadow: 0 0 0 3px rgba(1, 118, 211, 0.15);
            }

            .manual-field-textarea {
                min-height: 68px;
                resize: vertical;
                font-size: 12.5px;
                line-height: 1.4;
            }

            .manual-error-alert {
                display: none;
                background: #FEF2F2;
                border: 1px solid #FECACA;
                color: #991B1B;
                padding: 8px 12px;
                border-radius: 6px;
                font-size: 13px;
                line-height: 1.4;
                align-items: center;
                gap: 8px;
            }

            .manual-error-alert.show {
                display: flex;
