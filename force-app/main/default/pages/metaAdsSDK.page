        <!-- Loading Spinner Full Page -->
        <div id="loading-spinner" class="spinner-overlay">
            <div class="spinner-container">
                <div class="spinner-big"></div>
                <div class="spinner-text">Loading...</div>
            </div>
        </div>

        <script>
            var isConnected = {!isConnected};

            document.addEventListener("DOMContentLoaded", function () {
                if (isConnected && '{!hasConfig}' === 'true') {
                    document.getElementById('setup-form-div').style.display = 'none';
                    checkStatusOnLoad();
                }
            });

            function checkStatusOnLoad() {
                var errorEl = document.getElementById('error-message');
                setLoading(true, 'Checking connection status...');
                Visualforce.remoting.Manager.invokeAction(
                    '{!$RemoteAction.MetaAdsTokenController.checkConnectionStatus}',
                    function (result, event) {
                        resetButton();
                        if (event.status && result && result.success) {
                            renderResults(result);
                        } else {
                            document.getElementById('setup-form-div').style.display = 'block';
                            if (errorEl) errorEl.textContent = 'Connection check failed: ' + (result ? result.message : event.message);
                        }
                    },
                    { escape: true }
                );
            }

            function deactivateMetaAds() {
                if (confirm('Are you sure you want to deactivate the Meta Ads integration? This will disconnect your account.')) {
                    setLoading(true, 'Deactivating...');
                    Visualforce.remoting.Manager.invokeAction(
                        '{!$RemoteAction.MetaAdsTokenController.deactivateConnection}',
                        function (result, event) {
                            if (event.status && result && result.success) {
                                window.location.reload();
                            } else {
                                resetButton();
                                alert('Failed to deactivate: ' + (result ? result.message : event.message));
                            }
                        },
                        { escape: true }
                    );
                }
            }

            function backToControlCenter() {
                var basePath = '/lightning/n/MVEX__Control_Center';
                window.top.location.href = basePath;
            }

            function launchMetaAdsSignup() {
                var errorEl = document.getElementById('error-message');
                errorEl.textContent = '';

                var appIdInput = document.getElementById('app-id-input').value.trim();
                if (!appIdInput) {
                    errorEl.textContent = 'Please enter your Meta Application ID to proceed.';
                    return;
                }

                if (typeof FB === 'undefined') {
                    errorEl.textContent = 'Meta SDK is still loading... please wait a few seconds and try again.';
                    return;
                }

                setLoading(true);

                try {
                    FB.login(function (response) {
                        console.log('[Meta Ads] FB.login response:', response);

                        if (response.status === 'connected' && response.authResponse) {
                            var code = response.authResponse.code;

                            if (!code) {
                                errorEl.textContent = 'Authorization code not received.';
                                resetButton();
                                return;
                            }

                            // ── Call Apex to exchange code, subscribe webhook & discover forms ──
                            Visualforce.remoting.Manager.invokeAction(
                                '{!$RemoteAction.MetaAdsTokenController.exchangeCodeForToken}',
                                code,
                                appIdInput,
                                function (result, event) {
                                    resetButton();
                                    if (event.status && result) {
                                        if (result.success) {
                                            console.log('[Meta Ads] Complete Success:', result);
                                            renderResults(result);
                                        } else {
                                            errorEl.textContent = 'Meta API Error: ' + result.message;
                                        }
                                    } else {
                                        errorEl.textContent = 'Remoting Error: ' + (event.message || 'Unknown error');
                                    }
                                },
                                { escape: true }
                            );

                        } else {
                            errorEl.textContent = 'Login was cancelled or window closed.';
                            resetButton();
                        }
                    }, {
                        config_id: '{!JSENCODE(metaConfigId)}',
                        response_type: 'code',
                        override_default_response_type: true
                    });
                } catch (e) {
                    errorEl.textContent = 'Exception: ' + e.message;
                    resetButton();
                }
            }

            function setLoading(loading, msg) {
                var btn = document.getElementById('connect-btn');
                var btnText = document.getElementById('btn-text');
                var spinner = document.getElementById('btn-spinner');

                var overlay = document.getElementById('loading-spinner');

                if (loading) {
                    if (msg) {
                        overlay.classList.add('show');
                        overlay.querySelector('.spinner-text').textContent = msg;
                    } else {
                        if (btn) btn.disabled = true;
                        if (btnText) btnText.textContent = 'Subscribing Webhooks...';
                        if (spinner) spinner.style.display = 'block';
                    }
                } else {
                    overlay.classList.remove('show');
                    if (btn) btn.disabled = false;
                    if (btnText) btnText.textContent = 'Connect with Meta';
                    if (spinner) spinner.style.display = 'none';
                }
            }

            function resetButton() {
                setLoading(false);
            }

            function renderResults(data) {
                var basePath = '/lightning/n/MVEX__Control_Center';

                // Show loading spinner while Metadata API deploys
                setLoading(true, 'Saving configuration... Please wait');
                window.top.location.href = basePath + '?c__openComponent=metaAdsMapping';
            }
        </script>
    </body>

    </html>
